# Copy to .env.local for local development. Never commit .env.local.
# Production and preview values live in Vercel project settings.

# Supabase project "TUC" (organisation owned by TrustUsConsult, region eu-central-1 Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://fghgbjfvdtuhxfmqgzgo.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; row-level security guards the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Only needed for admin scripts and edge functions. Never expose to the browser.
# SUPABASE_SECRET_KEY=

# Transactional email (Resend). Without RESEND_API_KEY mails are printed to the server log and not sent.
# The key is server-only. In Vercel set it for Production and Preview.
# RESEND_API_KEY=
# From header once the sending domain is verified in Resend, e.g. "TrustUsConsult <huset@trustusconsult.dk>".
# EMAIL_FROM=
# Where the house is notified. Defaults: optagelse@ and kontakt@trustusconsult.dk (src/content/site.ts).
# EMAIL_NOTIFY_APPLICATIONS=
# EMAIL_NOTIFY_CONTACT=

# CV import on Min side: a PDF or pasted text becomes the profile fields, through OpenRouter. Server-only.
# Without the key the import section says it is not enabled. Set in Vercel for Production and Preview.
# OPENROUTER_API_KEY=
# The model behind it, any OpenRouter id with structured outputs. Default: deepseek/deepseek-v4.1-flash.
# OPENROUTER_MODEL=
# How OpenRouter turns an uploaded PDF into text for the model: pdf-text (free, default), mistral-ocr (scanned PDFs, paid), native (models that read PDFs).
# OPENROUTER_PDF_ENGINE=
